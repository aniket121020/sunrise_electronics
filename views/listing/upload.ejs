<% layout("/layouts/boilerplate.ejs") -%> 
<body>
    <form method="post" action="/listing/new">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" placeholder="Add title" class="form-control">
           </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <input type="text" name="listing[description]" placeholder="Enter description" class="form-control">
           </div>
           <div class="mb-3">
            <label for="image" class="form-label">Image Link</label>
            <input type="text" name="listing[image]" placeholder="Enter image Link/Url" class="form-control">
           </div>
           <br><br>
           <button class="btn btn-dark">Submit!</button>
    </form>
    
</body>